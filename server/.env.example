PORT=3000
DATABASE_URL=postgres://calvin:calvin123@localhost:5432/droit_accessible
JWT_SECRET=change-this-secret-in-production
FRONTEND_URL=http://localhost:4200
# Envoi d'e-mails au demandeur (bouton « Contacter par e-mail »).
# Sans ces variables, l'API repond 503 et le bouton bascule sur un mailto:.
# Fournisseur gratuit recommande : Brevo (brevo.com) > Smozle > SMTP & API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# --- Envoi d'e-mail SANS SMTP : une seule cle suffit (prioritaire sur SMTP) ---
# Au choix, renseignez UNE des deux lignes :
#   1) Formspree : creer un formulaire sur formspree.io, puis
#   2) Web3Forms : creer une access key sur web3forms.com
FORMSPREE_URL=
WEB3FORMS_KEY=